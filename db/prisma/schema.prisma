// The single source of truth for Seepwatch's data. Models use camelCase in
// TypeScript and are mapped to snake_case tables and columns in PostgreSQL.

// Generated into src/ so tsc builds it with the rest of the package; never committed.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The connection string comes from prisma.config.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  SUPER_ADMIN
}

enum TeamRole {
  OWNER
  MEMBER
}

// What a watch looks for. Domains and organizations must be proven to be the owner's
// before any scan uses them; addresses hang off a verified domain; key patterns are
// only ever matched inside content that is already the owner's.
enum WatchKind {
  DOMAIN
  EMAIL
  GITHUB_ORG
  KEY_PATTERN
}

// The characters a custom key may use after its prefix. A fixed set rather than a
// user's regular expression, so no pattern can make the scanner backtrack for ever.
enum KeyCharset {
  ALNUM
  HEX
  BASE64URL
}

// Where a leaked secret was seen. Gists and paste sites join this list later.
enum FindingSource {
  // A line added by a commit to one of the owner's organizations' repositories.
  GITHUB_COMMIT
  // A file GitHub's code search found by one of the owner's domains or addresses.
  GITHUB_CODE
}

// Email isn't a channel: alerts are emailed to the account's owner and to team
// members who accepted an invite, never to an address someone merely typed in.
enum ChannelType {
  SLACK
  TELEGRAM
  WEBHOOK
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          Role      @default(USER)
  // Encrypted at rest; null until two-factor sign-in is set up.
  totpSecret    String?   @map("totp_secret")
  // Set once the user proves they can produce a code; until then the secret is pending.
  totpEnabledAt DateTime? @map("totp_enabled_at")
  // The time step of the last accepted code; older or equal steps are refused as replays.
  totpLastStep  Int?      @map("totp_last_step")
  failedLogins  Int       @default(0) @map("failed_logins")
  lockedUntil   DateTime? @map("locked_until")
  // Set by an admin: no sign-in, no API access, no checks or alerts until cleared.
  suspendedAt   DateTime? @map("suspended_at")
  // Null means the default plan, so changing the default moves everyone on it.
  planId        String?   @map("plan_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  channels    NotificationChannel[]
  watches     Watch[]
  findings    Finding[]
  ownedTeam   Team?
  apiKeys     ApiKey[]
  memberships TeamMember[]
  sessions    Session[]
  resetTokens PasswordResetToken[]
  backupCodes BackupCode[]
  auditLogs   AuditLog[]

  @@map("users")
}

// What an account may use. Exactly one plan is the default, for everyone without one.
model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  maxWatches  Int      @map("max_watches")
  maxChannels Int      @map("max_channels")
  maxApiKeys  Int      @map("max_api_keys")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("plans")
}

// Every admin action: who, what, to whom, from where. Rows are only ever added.
// The actor's email is copied in, so the record survives the account's deletion.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String   @map("actor_email")
  action     String
  // What the action was done to, as an id and as it read at the time.
  targetId   String?  @map("target_id")
  target     String?
  ip         String?
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetId])
  @@map("audit_logs")
}

// A key for the public REST API. Only its hash is kept; the key is shown once.
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  name       String
  keyHash    String    @unique @map("key_hash")
  // The key's first characters, so the owner can tell keys apart.
  prefix     String
  lastUsedAt DateTime? @map("last_used_at")
  // Revoked keys stay listed, so it's clear what stopped working and when.
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("api_keys")
}

// One row per signed-in device. The refresh token itself is never stored, only its hash.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  // True once the second factor was checked for this session.
  mfa              Boolean   @default(false)
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Ten single-use codes for when the authenticator app is lost.
model BackupCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("backup_codes")
}

// Every user has one team, made the first time they open it. Its members are the
// people escalation can reach.
model Team {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @unique @map("owner_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  owner    User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members  TeamMember[]
  invites  TeamInvite[]
  policies EscalationPolicy[]

  @@map("teams")
}

model TeamMember {
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// An emailed invitation. Only the token's hash is kept; accepting it needs an
// account with the invited address.
model TeamInvite {
  id         String    @id @default(uuid()) @db.Uuid
  teamId     String    @map("team_id") @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("team_invites")
}

model EscalationPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  name      String
  // [{ waitMinutes, targets: [{ kind: "member", userId } | { kind: "channel", channelId }] }]
  // The first step's wait is 0: it's who hears first.
  steps     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  watches Watch[]

  @@index([teamId])
  @@map("escalation_policies")
}

model NotificationChannel {
  id         String      @id @default(uuid()) @db.Uuid
  ownerId    String      @map("owner_id") @db.Uuid
  type       ChannelType
  name       String
  // AES-GCM ciphertext of the channel's JSON settings (webhook URLs, bot tokens).
  config     String
  // Disabled channels keep their settings but get no alerts.
  enabled    Boolean     @default(true)
  lastSentAt DateTime?   @map("last_sent_at")
  // Why the last delivery failed; null when it went through.
  lastError  String?     @map("last_error")
  createdAt  DateTime    @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("notification_channels")
}

// Something of the owner's to look for in public code and pastes.
model Watch {
  id                 String      @id @default(uuid()) @db.Uuid
  ownerId            String      @map("owner_id") @db.Uuid
  kind               WatchKind
  // Lowercased: "example.com", "ops@example.com", "acme". For a key pattern, its prefix.
  value              String
  // The owner's own name for it, shown instead of the value where there's room.
  label              String?
  // An address's domain watch. Deleting the domain deletes its addresses.
  domainWatchId      String?     @map("domain_watch_id") @db.Uuid
  // A key pattern's shape after the prefix: which characters, and how many.
  keyCharset         KeyCharset? @map("key_charset")
  keyMinLength       Int?        @map("key_min_length")
  keyMaxLength       Int?        @map("key_max_length")
  // Domains and organizations: the token to publish, and when it was last found.
  // Scans skip a watch until verifiedAt is set.
  verifyToken        String?     @map("verify_token")
  verifiedAt         DateTime?   @map("verified_at")
  lastVerifyAt       DateTime?   @map("last_verify_at")
  // Why the last attempt failed, in words for the owner; null after a success.
  lastVerifyError    String?     @map("last_verify_error")
  // Daily re-checks that failed in a row. Three take the verification away: the
  // domain or organization may have changed hands.
  verifyFailures     Int         @default(0) @map("verify_failures")
  // When the last scan finished, and why it stopped short if it did.
  lastScanAt         DateTime?   @map("last_scan_at")
  lastScanError      String?     @map("last_scan_error")
  // Where an organization scan picks up: commits after this moment are still to read.
  scanCursor         DateTime?   @map("scan_cursor")
  // A paused watch keeps its verification but isn't scanned.
  enabled            Boolean     @default(true)
  // Who hears about a leak it finds. Null: the owner and every channel, at once.
  escalationPolicyId String?     @map("escalation_policy_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  domainWatch      Watch?            @relation("DomainAddresses", fields: [domainWatchId], references: [id], onDelete: Cascade)
  addresses        Watch[]           @relation("DomainAddresses")
  escalationPolicy EscalationPolicy? @relation(fields: [escalationPolicyId], references: [id], onDelete: SetNull)
  findings         Finding[]

  @@unique([ownerId, kind, value])
  @@index([domainWatchId])
  @@map("watches")
}

// One leaked secret, however many places it turned up in. The secret itself is never
// stored: the fingerprint tells two sightings of it apart from the rest, and the
// masked form is enough for the owner to recognise which key it was.
model Finding {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  // The watch whose scan found it first. Kept when the watch is deleted, unlinked.
  watchId     String?  @map("watch_id") @db.Uuid
  // Which detector matched: "aws-access-key", "private-key", "key-pattern" and so on.
  detector    String
  // HMAC-SHA256 of the secret, keyed from ENCRYPTION_KEY, so a database leak can't be
  // turned back into keys by hashing guesses.
  fingerprint String
  // The first and last few characters: "AKIA…7XQ2".
  masked      String
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  watch     Watch?            @relation(fields: [watchId], references: [id], onDelete: SetNull)
  locations FindingLocation[]

  @@unique([ownerId, fingerprint])
  @@index([ownerId, firstSeenAt])
  @@map("findings")
}

// One place a finding was seen. The same secret in a second file is a second row.
model FindingLocation {
  id          BigInt        @id @default(autoincrement())
  findingId   String        @map("finding_id") @db.Uuid
  source      FindingSource
  // A link to the exact line, pinned to the commit so it doesn't drift.
  url         String
  repository  String
  path        String
  commitSha   String?       @map("commit_sha")
  line        Int?
  // The lines around it, with every secret in them masked.
  context     String
  committedAt DateTime?     @map("committed_at")
  seenAt      DateTime      @default(now()) @map("seen_at")

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([findingId, url])
  @@map("finding_locations")
}
