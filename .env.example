# Copy this file to .env and fill in real values. .env is never committed.

# --- Infrastructure (docker-compose.yml reads these too) ---
POSTGRES_USER=seepwatch
POSTGRES_PASSWORD=seepwatch
POSTGRES_DB=seepwatch
# 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 (::1) first, where
# the containers don't listen, and every new connection waits two seconds to fall back.
DATABASE_URL=postgresql://seepwatch:seepwatch@127.0.0.1:5432/seepwatch
REDIS_URL=redis://127.0.0.1:6379

# Password for demo@seepwatch.dev, created by `npm run db:seed`. Pick your own.
SEED_DEMO_PASSWORD=change-me-before-seeding

# --- Email (Mailpit in development) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Seepwatch <alerts@seepwatch.local>"

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Signs access tokens; anyone who has it can sign in as any user. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Encrypts TOTP secrets and channel tokens in the database, and signs the links in
# alerts; the worker reads it too. Losing it makes them unreadable: changing it locks
# everyone with two-factor out of the second step, leaving only their backup codes,
# and channels lose their tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Reverse proxies in front of the API (0 locally, usually 1 behind a load balancer).
TRUST_PROXY=0
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- GitHub ---
# Optional locally. Raises GitHub's limit from 60 to 5,000 requests an hour; a
# fine-grained token with no permissions is enough, since everything read is public.
# Searching for your domains and addresses needs it: GitHub's code search refuses
# anonymous callers.
GITHUB_TOKEN=
# Watches the worker scans at once. GitHub's limits are the bottleneck, not the CPU.
SCAN_CONCURRENCY=2

# Tests run against their own database so they never touch your data.
DATABASE_URL_TEST=postgresql://seepwatch:seepwatch@127.0.0.1:5432/seepwatch_test
